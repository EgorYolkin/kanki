[Unit]
Description=Kanki sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kanki-server
EnvironmentFile=%h/kanki-server/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --project %h/kanki-server uvicorn kanki_server.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
