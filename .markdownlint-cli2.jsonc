{
  // Правила Markdown для всех .md репозитория. Единый источник — docs/quality-gates.md.
  "config": {
    "default": true,
    // Русская проза и таблицы: переносить строки по 80 символов бессмысленно.
    "MD013": false,
    // Одинаковые подзаголовки в разных разделах встречаются в шаблонах issue.
    "MD024": { "siblings_only": true },
    // Шаблоны issue/PR используют HTML-комментарии как подсказки.
    "MD033": false,
    // Некоторые документы начинаются с HTML-комментария или front matter шаблона.
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": ["build/**", "Kanki.xcodeproj/**"]
}
